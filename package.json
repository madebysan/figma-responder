{
  "name": "figma-ai-responder",
  "version": "2.0.2",
  "description": "Menu bar app that responds to @AI mentions in Figma comments",
  "main": "dist/main/main.js",
  "author": "San",
  "license": "MIT",
  "scripts": {
    "build": "tsc && cp -r src/renderer dist/",
    "start": "npm run build && electron .",
    "dev": "tsc && cp -r src/renderer dist/ && electron .",
    "icons": "node scripts/generate-icons.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.san.figma-ai-responder",
    "productName": "Figma AI Responder",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "Santiago Alonso Alexandre (QAMM2A6WRQ)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "sign": false
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "madebysan",
        "repo": "figma-responder",
        "releaseType": "release"
      }
    ],
    "artifactName": "Figma-Responder-${version}-${arch}.${ext}",
    "extraResources": [
      "THIRD_PARTY_NOTICES.md",
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0"
  }
}
